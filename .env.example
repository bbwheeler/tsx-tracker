# Copy to .env and fill in, or export these as real environment variables.

# --- gRPC server ---
GRPC_PORT=50051

# --- PostgreSQL connection (configurable database) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tsx_tracker
DB_SSLMODE=disable

# --- Finnhub API (free tier) ---
# Get a free key at https://finnhub.io/ (no credit card required)
FINNHUB_API_KEY=your_api_key_here
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# --- Refresh behaviour ---
# How often the background refresher syncs the TSX symbol list (default: 24h).
REFRESH_CHECK_INTERVAL=24h
