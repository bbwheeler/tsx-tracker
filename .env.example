# Copy to .env and fill in, or export these as real environment variables.

# --- gRPC server ---
GRPC_PORT=50051

# --- PostgreSQL connection (configurable database) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tsx_tracker
DB_SSLMODE=disable

# --- Financial Modeling Prep API (free tier) ---
# Get a free key at https://site.financialmodelingprep.com/
FMP_API_KEY=your_api_key_here
FMP_BASE_URL=https://financialmodelingprep.com

# --- Refresh behaviour ---
# Data older than this is considered stale and re-fetched. Must be <= 24h.
STALENESS_THRESHOLD=24h
# How often the background refresher wakes up to look for stale/missing data.
REFRESH_CHECK_INTERVAL=30m
# Max companies whose full profile is fetched from the upstream API per cycle.
MAX_COMPANIES_PER_REFRESH_CYCLE=50
# Symbols per upstream "profile" batch request.
PROFILE_BATCH_SIZE=3
# Cap on total tracked companies (free-tier API rate limits can't support
# full-TSX-universe daily refreshes -- see README). 0 = no cap.
MAX_TRACKED_COMPANIES=300
