# Environment variables for Podman deployment (external Postgres).
# Fill in DB_USER, DB_PASSWORD, and FMP_API_KEY before running.

# --- gRPC server ---
GRPC_PORT=50051

# --- PostgreSQL (external instance) ---
DB_HOST=192.168.1.31
DB_PORT=5432
DB_USER=__FILL_IN__
DB_PASSWORD=__FILL_IN__
DB_NAME=tsx_tracker
DB_SSLMODE=disable

# --- Financial Modeling Prep API (free tier) ---
# Get a free key at https://site.financialmodelingprep.com/
FMP_API_KEY=__FILL_IN__
FMP_BASE_URL=https://financialmodelingprep.com

# --- Refresh behaviour ---
STALENESS_THRESHOLD=24h
REFRESH_CHECK_INTERVAL=30m
MAX_COMPANIES_PER_REFRESH_CYCLE=50
PROFILE_BATCH_SIZE=3
MAX_TRACKED_COMPANIES=300
