# Environment variables for Podman deployment (external Postgres).
# Fill in DB_USER and DB_PASSWORD before running.

# --- gRPC server ---
GRPC_PORT=50051

# --- PostgreSQL (external instance) ---
DB_HOST=192.168.1.31
DB_PORT=5432
DB_USER=__FILL_IN__
DB_PASSWORD=__FILL_IN__
DB_NAME=tsx_tracker
DB_SSLMODE=disable

# --- Refresh behaviour ---
# How often the background refresher syncs the TSX symbol list (default: 24h).
REFRESH_CHECK_INTERVAL=24h
